# PromptSlim — environment template (Phase 1 needs NO keys; the optimizer is fully local).
#
# These variables are reserved for Phase 3 (optional AI semantic optimization).
# Never hardcode API keys anywhere. Keys belong to the server (or user-supplied BYO
# settings in the extension) and must never be exposed in browser JavaScript.
#
# OPENROUTER_API_KEY=your-k…here   # Phase 3: AI semantic optimization (server-side only)
# OPENAI_API_KEY=                  # Phase 3: optional direct provider
# ANTHROPIC_API_KEY=               # Phase 3: optional direct provider
# GEMINI_API_KEY=                  # Phase 3: optional direct provider
